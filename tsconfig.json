{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "lib": ["ES2022", "dom"],
    "jsx": "react-jsx" // or "preserve" depending on your setup
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "Context/**/*",
    "constans",
    "utils/**/*"
  ]
}
