{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "lib": [
      "ES2022",
      "dom"
    ],
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "Context/**/*",
    "constans",
    "utils/**/*"
  ],
  "extends": "expo/tsconfig.base"
}
